{
  "multipart": [
    {
      "apply": {
        "model": "nyasamaelectricity:block/cable_core"
      }
    },
    {
      "when": {
        "up": "true"
      },
      "apply": {
        "model": "nyasamaelectricity:block/cable_side",
        "x": 180
      }
    },
    {
      "when": {
        "down": "true"
      },
      "apply": {
        "model": "nyasamaelectricity:block/cable_side"
      }
    },
    {
      "when": {
        "north": "true"
      },
      "apply": {
        "model": "nyasamaelectricity:block/cable_side",
        "x": 90,
        "y": 180
      }
    },
    {
      "when": {
        "south": "true"
      },
      "apply": {
        "model": "nyasamaelectricity:block/cable_side",
        "x": 90
      }
    },
    {
      "when": {
        "west": "true"
      },
      "apply": {
        "model": "nyasamaelectricity:block/cable_side",
        "x": 90,
        "y": 90
      }
    },
    {
      "when": {
        "east": "true"
      },
      "apply": {
        "model": "nyasamaelectricity:block/cable_side",
        "x": 90,
        "y": 270
      }
    }
  ]
}
